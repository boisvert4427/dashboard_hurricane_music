{% extends 'base.html.twig' %}

{% block title %}Détail lignes | Dashboard Hurricane Music{% endblock %}

{% block body %}
    {% set detail_group_by = active_filters.group_by|default('idart') %}
    {% set detail_group_label = {
        'idart': 'Produit',
        'brand': 'Fabricant',
        'channel': 'Canal',
        'category': 'Catégorie'
    }[detail_group_by]|default('Produit') %}
    {% set detail_group_secondary = active_filters.group_by_secondary|default('') %}
    <main class="app-shell">
        <section class="toolbar-panel">
            <div class="toolbar-head">
                <div>
                    <div class="toolbar-eyebrow">Filtres de lecture</div>
                    <h1 class="toolbar-title">Choisir la période et le périmètre</h1>
                </div>
                <p>Période sélectionnée : {{ period_label }}. Comparaison : {{ previous_period_label }}. Tu peux saisir les dates à la main ou ouvrir le calendrier.</p>
            </div>
            <div class="view-switch" aria-label="Mode d'affichage">
                <a class="button button-secondary" href="{{ path('app_home', active_filters|merge({'view': 'cards', 'group_by': active_filters.group_by|default('idart')})) }}">Cartes</a>
                <a class="button button-primary" href="{{ path('app_detail', active_filters|merge({'view': 'table', 'group_by': active_filters.group_by|default('idart'), 'page': 1, 'sort': sort, 'direction': direction, 'per_page': pagination.per_page})) }}">Tableau</a>
            </div>
            <form class="filter-form" method="get" action="{{ path('app_detail') }}">
                <input type="hidden" name="view" value="{{ active_filters.view|default('table') }}">
                <div class="filter-form__section">
                    <div class="filter-form__section-title">Périmètre analysé</div>
                    <div class="filter-form__grid filter-form__grid--scope">
                <div class="filter-field">
                    <label for="detail-search">Recherche</label>
                    <input id="detail-search" type="search" name="q" value="{{ active_filters.q|default('') }}" placeholder="Facture, produit, marque, canal...">
                </div>
                <div class="filter-field">
                    <label for="detail-start">Début</label>
                    <div class="date-field" data-date-field>
                        <input id="detail-start" class="date-field__input" type="text" name="start" value="{{ active_filters.start|default('') }}" placeholder="YYYY-MM-DD" inputmode="numeric" autocomplete="off" spellcheck="false" data-date-field-input>
                        <button class="date-field__button" type="button" aria-label="Ouvrir le calendrier" data-date-field-trigger>📅</button>
                        <input class="date-field__native" type="date" tabindex="-1" aria-hidden="true" data-date-field-native>
                    </div>
                </div>
                <div class="filter-field">
                    <label for="detail-end">Fin</label>
                    <div class="date-field" data-date-field>
                        <input id="detail-end" class="date-field__input" type="text" name="end" value="{{ active_filters.end|default('') }}" placeholder="YYYY-MM-DD" inputmode="numeric" autocomplete="off" spellcheck="false" data-date-field-input>
                        <button class="date-field__button" type="button" aria-label="Ouvrir le calendrier" data-date-field-trigger>📅</button>
                        <input class="date-field__native" type="date" tabindex="-1" aria-hidden="true" data-date-field-native>
                    </div>
                </div>
                <div class="filter-field">
                    <label for="detail-channel">Canal</label>
                    <select id="detail-channel" name="channel">
                        <option value="">Tous</option>
                        {% for option in filter_options.channels %}
                            <option value="{{ option.value }}" {% if active_filters.channel|default('') == option.value %}selected{% endif %}>{{ option.label }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="filter-field">
                    <label for="detail-brand">Marque</label>
                    <select id="detail-brand" name="brand_id">
                        <option value="">Toutes</option>
                        {% for option in filter_options.brands %}
                            <option value="{{ option.value }}" {% if active_filters.brand_id|default('') == option.value %}selected{% endif %}>{{ option.label }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="filter-field">
                    <label for="detail-category">Catégorie</label>
                    <select id="detail-category" name="category">
                        <option value="">Toutes</option>
                        {% for option in filter_options.categories %}
                            <option value="{{ option.value }}" {% if active_filters.category|default('') == option.value %}selected{% endif %}>{{ option.label }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="filter-field">
                    <label for="detail-supplier">Fournisseur</label>
                    <select id="detail-supplier" name="supplier_id">
                        <option value="">Tous</option>
                        {% for option in filter_options.suppliers %}
                            <option value="{{ option.value }}" {% if active_filters.supplier_id|default('') == option.value %}selected{% endif %}>{{ option.label }}</option>
                        {% endfor %}
                    </select>
                </div>
                    </div>
                </div>
                <div class="filter-form__section">
                    <div class="filter-form__section-title">Organisation du tableau</div>
                    <div class="filter-form__grid filter-form__grid--display">
                <div class="filter-field">
                    <label for="detail-occasion">Occasion</label>
                    <select id="detail-occasion" name="occasion">
                        <option value="">Toutes</option>
                        <option value="occasion" {% if active_filters.occasion|default('') == 'occasion' %}selected{% endif %}>Occasion</option>
                        <option value="hors_occasion" {% if active_filters.occasion|default('') == 'hors_occasion' %}selected{% endif %}>Hors occasion</option>
                    </select>
                </div>
                <div class="filter-field">
                    <label for="detail-group-by">Regroupement principal</label>
                    <select id="detail-group-by" name="group_by" data-primary-group-select>
                        <option value="idart" {% if active_filters.group_by|default('idart') == 'idart' %}selected{% endif %}>IDART</option>
                        <option value="brand" {% if active_filters.group_by|default('idart') == 'brand' %}selected{% endif %}>Fabricant</option>
                        <option value="channel" {% if active_filters.group_by|default('idart') == 'channel' %}selected{% endif %}>Canal</option>
                        <option value="category" {% if active_filters.group_by|default('idart') == 'category' %}selected{% endif %}>Catégorie</option>
                    </select>
                </div>
                <div class="filter-field">
                    <label for="detail-group-by-secondary">Deuxième niveau (au clic)</label>
                    <select id="detail-group-by-secondary" name="group_by_secondary" data-secondary-group-select>
                        <option value="">Aucun sous-groupe</option>
                        <option value="product" {% if detail_group_secondary == 'product' %}selected{% endif %}>Produit</option>
                        <option value="brand" {% if detail_group_secondary == 'brand' %}selected{% endif %}>Fabricant</option>
                        <option value="channel" {% if detail_group_secondary == 'channel' %}selected{% endif %}>Canal</option>
                        <option value="category" {% if detail_group_secondary == 'category' %}selected{% endif %}>Catégorie</option>
                    </select>
                </div>
                <div class="filter-field">
                    <label for="detail-sort">Tri</label>
                    <select id="detail-sort" name="sort">
                        <option value="invoice_date" {% if sort == 'invoice_date' %}selected{% endif %}>Date</option>
                        <option value="invoice_number" {% if sort == 'invoice_number' %}selected{% endif %}>Facture</option>
                        <option value="channel_name" {% if sort == 'channel_name' %}selected{% endif %}>Canal</option>
                        <option value="brand_name" {% if sort == 'brand_name' %}selected{% endif %}>Marque</option>
                        <option value="product_name" {% if sort == 'product_name' %}selected{% endif %}>Produit</option>
                        <option value="total_ht" {% if sort == 'total_ht' %}selected{% endif %}>CA HT</option>
                        <option value="margin_ht" {% if sort == 'margin_ht' %}selected{% endif %}>Marge HT</option>
                        <option value="quantity" {% if sort == 'quantity' %}selected{% endif %}>Quantité</option>
                        <option value="is_occasion" {% if sort == 'is_occasion' %}selected{% endif %}>Occasion</option>
                    </select>
                </div>
                <div class="filter-field">
                    <label for="detail-direction">Ordre</label>
                    <select id="detail-direction" name="direction">
                        <option value="desc" {% if direction == 'desc' %}selected{% endif %}>Descendant</option>
                        <option value="asc" {% if direction == 'asc' %}selected{% endif %}>Ascendant</option>
                    </select>
                </div>
                <div class="filter-field">
                    <label for="detail-per-page">Lignes</label>
                    <select id="detail-per-page" name="per_page">
                        <option value="25" {% if pagination.per_page == 25 %}selected{% endif %}>25</option>
                        <option value="50" {% if pagination.per_page == 50 %}selected{% endif %}>50</option>
                        <option value="100" {% if pagination.per_page == 100 %}selected{% endif %}>100</option>
                    </select>
                </div>
                    </div>
                </div>
                <div class="filter-actions">
                    <input type="hidden" name="page" value="1">
                    <button class="button button-primary" type="submit">Appliquer</button>
                    <a class="button button-secondary" href="{{ path('app_detail') }}">Réinitialiser</a>
                    <a class="button button-secondary" href="{{ path('app_detail_export', active_filters|merge({'sort': sort, 'direction': direction})) }}">CSV</a>
                </div>
            </form>
        </section>

        <section class="section">
            <div class="section-head">
                <h2>Tableau ligne par ligne</h2>
                <p>{{ pagination.total_rows }} ligne(s) trouvée(s).</p>
            </div>

            <div class="detail-table-wrap">
                <table class="detail-table">
                    <thead>
                        <tr>
                            {% if detail_group_by not in ['brand', 'channel'] %}
                                <th><a class="table-sort-link{% if sort == 'invoice_date' %} is-active{% endif %}" href="{{ path('app_detail', active_filters|merge({'sort': 'invoice_date', 'direction': sort == 'invoice_date' and direction == 'asc' ? 'desc' : 'asc', 'page': 1, 'per_page': pagination.per_page})) }}">Date <span>{{ sort == 'invoice_date' ? (direction == 'asc' ? '▲' : '▼') : '↕' }}</span></a></th>
                                <th><a class="table-sort-link{% if sort == 'channel_name' %} is-active{% endif %}" href="{{ path('app_detail', active_filters|merge({'sort': 'channel_name', 'direction': sort == 'channel_name' and direction == 'asc' ? 'desc' : 'asc', 'page': 1, 'per_page': pagination.per_page})) }}">Canal <span>{{ sort == 'channel_name' ? (direction == 'asc' ? '▲' : '▼') : '↕' }}</span></a></th>
                            {% endif %}
                            {% if detail_group_by not in ['brand', 'channel'] %}
                                <th><a class="table-sort-link{% if sort == 'brand_name' %} is-active{% endif %}" href="{{ path('app_detail', active_filters|merge({'sort': 'brand_name', 'direction': sort == 'brand_name' and direction == 'asc' ? 'desc' : 'asc', 'page': 1, 'per_page': pagination.per_page})) }}">Marque <span>{{ sort == 'brand_name' ? (direction == 'asc' ? '▲' : '▼') : '↕' }}</span></a></th>
                            {% endif %}
                            <th><a class="table-sort-link{% if sort == 'product_name' %} is-active{% endif %}" href="{{ path('app_detail', active_filters|merge({'sort': 'product_name', 'direction': sort == 'product_name' and direction == 'asc' ? 'desc' : 'asc', 'page': 1, 'per_page': pagination.per_page})) }}">{{ detail_group_label }} <span>{{ sort == 'product_name' ? (direction == 'asc' ? '▲' : '▼') : '↕' }}</span></a></th>
                            <th><a class="table-sort-link{% if sort == 'quantity' %} is-active{% endif %}" href="{{ path('app_detail', active_filters|merge({'sort': 'quantity', 'direction': sort == 'quantity' and direction == 'asc' ? 'desc' : 'asc', 'page': 1, 'per_page': pagination.per_page})) }}">Qté <span>{{ sort == 'quantity' ? (direction == 'asc' ? '▲' : '▼') : '↕' }}</span></a></th>
                            <th><a class="table-sort-link{% if sort == 'total_ht' %} is-active{% endif %}" href="{{ path('app_detail', active_filters|merge({'sort': 'total_ht', 'direction': sort == 'total_ht' and direction == 'asc' ? 'desc' : 'asc', 'page': 1, 'per_page': pagination.per_page})) }}">CA HT <span>{{ sort == 'total_ht' ? (direction == 'asc' ? '▲' : '▼') : '↕' }}</span></a></th>
                            <th><a class="table-sort-link{% if sort == 'margin_ht' %} is-active{% endif %}" href="{{ path('app_detail', active_filters|merge({'sort': 'margin_ht', 'direction': sort == 'margin_ht' and direction == 'asc' ? 'desc' : 'asc', 'page': 1, 'per_page': pagination.per_page})) }}">Marge <span>{{ sort == 'margin_ht' ? (direction == 'asc' ? '▲' : '▼') : '↕' }}</span></a></th>
                            <th>Valeur stock</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% set total_quantity_progression = comparison_previous_year.quantity != 0 ? ((summary.quantity - comparison_previous_year.quantity) / (comparison_previous_year.quantity|abs) * 100) : null %}
                        {% set total_ca_progression = comparison_previous_year.total_ht != 0 ? ((summary.total_ht - comparison_previous_year.total_ht) / (comparison_previous_year.total_ht|abs) * 100) : null %}
                        {% set total_margin_progression = comparison_previous_year.margin_ht != 0 ? ((summary.margin_ht - comparison_previous_year.margin_ht) / (comparison_previous_year.margin_ht|abs) * 100) : null %}
                        {% set total_stock_progression = stock_totals.previous|default(0) != 0 ? ((stock_totals.current|default(0) - stock_totals.previous) / (stock_totals.previous|abs) * 100) : null %}
                        <tr class="detail-table-total">
                            <td colspan="{{ detail_group_by in ['brand', 'channel'] ? 1 : 4 }}"><strong>Total filtré</strong></td>
                            <td><div class="comparison-cell"><strong>{{ summary.quantity|number_format(0, ',', ' ') }}</strong><small>N-1 : {{ comparison_previous_year.quantity|number_format(0, ',', ' ') }} · <span class="metric-progression {{ total_quantity_progression is null ? 'delta-neutral' : (total_quantity_progression > 0 ? 'delta-up' : (total_quantity_progression < 0 ? 'delta-down' : 'delta-neutral')) }}">{{ total_quantity_progression is null ? '--' : ((total_quantity_progression > 0 ? '+' : '') ~ total_quantity_progression|number_format(1, ',', ' ') ~ ' %') }}</span></small></div></td>
                            <td><div class="comparison-cell"><strong>{{ summary.total_ht|number_format(0, ',', ' ') }} €</strong><small>N-1 : {{ comparison_previous_year.total_ht|number_format(0, ',', ' ') }} € · <span class="metric-progression {{ total_ca_progression is null ? 'delta-neutral' : (total_ca_progression > 0 ? 'delta-up' : (total_ca_progression < 0 ? 'delta-down' : 'delta-neutral')) }}">{{ total_ca_progression is null ? '--' : ((total_ca_progression > 0 ? '+' : '') ~ total_ca_progression|number_format(1, ',', ' ') ~ ' %') }}</span></small></div></td>
                            <td><div class="comparison-cell"><strong>{{ summary.margin_ht|number_format(0, ',', ' ') }} €{% if summary.total_ht > 0 %} · {{ (summary.margin_ht / summary.total_ht * 100)|number_format(1, ',', ' ') }} %{% endif %}</strong><small>N-1 : {{ comparison_previous_year.margin_ht|number_format(0, ',', ' ') }} € · <span class="metric-progression {{ total_margin_progression is null ? 'delta-neutral' : (total_margin_progression > 0 ? 'delta-up' : (total_margin_progression < 0 ? 'delta-down' : 'delta-neutral')) }}">{{ total_margin_progression is null ? '--' : ((total_margin_progression > 0 ? '+' : '') ~ total_margin_progression|number_format(1, ',', ' ') ~ ' %') }}</span></small></div></td>
                            <td><div class="comparison-cell"><strong>{{ stock_totals.current|default(0)|number_format(0, ',', ' ') }} €</strong><small>N-1 : {{ stock_totals.previous|default(0)|number_format(0, ',', ' ') }} € · <span class="metric-progression {{ total_stock_progression is null ? 'delta-neutral' : (total_stock_progression > 0 ? 'delta-up' : (total_stock_progression < 0 ? 'delta-down' : 'delta-neutral')) }}">{{ total_stock_progression is null ? '--' : ((total_stock_progression > 0 ? '+' : '') ~ total_stock_progression|number_format(1, ',', ' ') ~ ' %') }}</span></small></div></td>
                        </tr>
                        {% for row in rows %}
                            {% set quantity_progression = row.previous_quantity != 0 ? ((row.quantity - row.previous_quantity) / (row.previous_quantity|abs) * 100) : null %}
                            {% set ca_progression = row.previous_total_ht != 0 ? ((row.total_ht - row.previous_total_ht) / (row.previous_total_ht|abs) * 100) : null %}
                            {% set margin_progression = row.previous_margin_ht != 0 ? ((row.margin_ht - row.previous_margin_ht) / (row.previous_margin_ht|abs) * 100) : null %}
                            {% set stock_progression = row.previous_stock_pamp_value|default(0) != 0 ? ((row.stock_pamp_value|default(0) - row.previous_stock_pamp_value) / (row.previous_stock_pamp_value|abs) * 100) : null %}
                            {% set row_group_key = row.group_key|default(row.idart|default('')) %}
                            {% set is_expandable = detail_group_secondary != '' and detail_group_secondary != detail_group_by and not (detail_group_by == 'idart' and detail_group_secondary == 'product') %}
                            <tr{% if is_expandable %} class="detail-primary-row" tabindex="0" role="button" aria-expanded="false" data-detail-drilldown-url="{{ path('app_detail_subgroup', active_filters|merge({'primary_group': detail_group_by, 'primary_key': row_group_key, 'secondary_group': detail_group_secondary})) }}"{% endif %}>
                                {% if detail_group_by not in ['brand', 'channel'] %}
                                    <td>{{ row.invoice_date }}</td>
                                    <td>{{ row.channel_name }}</td>
                                {% endif %}
                                {% if detail_group_by not in ['brand', 'channel'] %}
                                    <td>{{ row.brand_name }}</td>
                                {% endif %}
                                <td>
                                    <div class="detail-product">
                                        <strong>{% if is_expandable %}<span class="detail-row-chevron" aria-hidden="true">›</span>{% endif %}{{ row.product_name }}</strong>
                                        {% if row.product_code and row.product_code != row.product_name %}<span>{{ row.product_code }}</span>{% endif %}
                                    </div>
                                </td>
                                <td><div class="comparison-cell"><strong>{{ row.quantity|number_format(0, ',', ' ') }}</strong><small>N-1 : {{ row.previous_quantity|number_format(0, ',', ' ') }} · <span class="metric-progression {{ quantity_progression is null ? 'delta-neutral' : (quantity_progression > 0 ? 'delta-up' : (quantity_progression < 0 ? 'delta-down' : 'delta-neutral')) }}">{{ quantity_progression is null ? '--' : ((quantity_progression > 0 ? '+' : '') ~ quantity_progression|number_format(1, ',', ' ') ~ ' %') }}</span></small></div></td>
                                <td><div class="comparison-cell"><strong>{{ row.total_ht|number_format(0, ',', ' ') }} €</strong><small>N-1 : {{ row.previous_total_ht|number_format(0, ',', ' ') }} € · <span class="metric-progression {{ ca_progression is null ? 'delta-neutral' : (ca_progression > 0 ? 'delta-up' : (ca_progression < 0 ? 'delta-down' : 'delta-neutral')) }}">{{ ca_progression is null ? '--' : ((ca_progression > 0 ? '+' : '') ~ ca_progression|number_format(1, ',', ' ') ~ ' %') }}</span></small></div></td>
                                <td><div class="comparison-cell"><strong>{{ row.margin_ht|number_format(0, ',', ' ') }} €{% if row.total_ht > 0 %} · {{ (row.margin_ht / row.total_ht * 100)|number_format(1, ',', ' ') }} %{% endif %}</strong><small>N-1 : {{ row.previous_margin_ht|number_format(0, ',', ' ') }} € · <span class="metric-progression {{ margin_progression is null ? 'delta-neutral' : (margin_progression > 0 ? 'delta-up' : (margin_progression < 0 ? 'delta-down' : 'delta-neutral')) }}">{{ margin_progression is null ? '--' : ((margin_progression > 0 ? '+' : '') ~ margin_progression|number_format(1, ',', ' ') ~ ' %') }}</span></small></div></td>
                                <td><div class="comparison-cell"><strong>{{ row.stock_pamp_value|default(0)|number_format(0, ',', ' ') }} €</strong><small>N-1 : {{ row.previous_stock_pamp_value|default(0)|number_format(0, ',', ' ') }} € · <span class="metric-progression {{ stock_progression is null ? 'delta-neutral' : (stock_progression > 0 ? 'delta-up' : (stock_progression < 0 ? 'delta-down' : 'delta-neutral')) }}">{{ stock_progression is null ? '--' : ((stock_progression > 0 ? '+' : '') ~ stock_progression|number_format(1, ',', ' ') ~ ' %') }}</span></small></div></td>
                            </tr>
                            {% if is_expandable %}
                                <tr class="detail-drilldown-row" hidden data-detail-drilldown-row>
                                    <td colspan="{{ detail_group_by in ['brand', 'channel'] ? 5 : 8 }}">
                                        <div class="detail-drilldown" data-detail-drilldown-content></div>
                                    </td>
                                </tr>
                            {% endif %}
                        {% else %}
                            <tr>
                                <td colspan="{{ detail_group_by in ['brand', 'channel'] ? 5 : 8 }}" class="detail-empty">Aucune ligne trouvée.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <div class="pagination-bar">
                <div class="pagination-meta">Page {{ pagination.page }} / {{ pagination.total_pages }}</div>
                <div class="pagination-actions">
                    <a class="button button-secondary {% if pagination.page <= 1 %}button-disabled{% endif %}" href="{{ pagination.page > 1 ? path('app_detail', active_filters|merge({'page': pagination.page - 1, 'sort': sort, 'direction': direction})) : '#' }}">Précédent</a>
                    <a class="button button-secondary {% if pagination.page >= pagination.total_pages %}button-disabled{% endif %}" href="{{ pagination.page < pagination.total_pages ? path('app_detail', active_filters|merge({'page': pagination.page + 1, 'sort': sort, 'direction': direction})) : '#' }}">Suivant</a>
                </div>
            </div>
        </section>
    </main>
{% endblock %}
